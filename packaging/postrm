#!/bin/bash
# postrm do pacote pesquisai (UFVAI)
set -e

case "${1:-}" in
    remove|purge)
        # Restos de bytecode criados em tempo de execução (não pertencem ao dpkg)
        if [ -d /opt/pesquisai ]; then
            find /opt/pesquisai -type d -name '__pycache__' -prune \
                -exec rm -rf {} + 2>/dev/null || true
        fi
        command -v update-desktop-database >/dev/null 2>&1 && \
            update-desktop-database -q /usr/share/applications 2>/dev/null || true
        ;;
esac

exit 0
